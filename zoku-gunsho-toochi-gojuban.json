   "genre": "",
   "ban": "七",
   "side": "左",
   "dai": "泊瀬山"
  },
  {
   "seq": "14",
   "text": "春の夜のかすめる空もみるまゝに暁ふかくすめる月哉",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "七",
   "side": "右",
   "dai": "勝春暁月"
  },
  {
   "seq": "15",
   "text": "春風に岸の柳も水鳥のあしのいになくなひくかけ哉",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "八",
   "side": "左",
   "dai": "柳"
  },
  {
   "seq": "16",
   "text": "咲花をそことをしへと尋行まほろしもかな春の山にみ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "八",
   "side": "右",
   "dai": "膳蔵"
  },
  {
   "seq": "17",
   "text": "又やみむ春は有とも明ほのの花にかすめる山のはの月",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "九",
   "side": "",
   "dai": ""
  },
  {
   "seq": "18",
   "text": "難たつかた野のみのゝかり衣かすみにすれる花のそてかな",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "九",
   "side": "右",
   "dai": "同"
  },
  {
   "seq": "19",
   "text": "古郷にきつゝかへれと錦にもあらぬかすみのころもかりかね",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "十",
   "side": "左",
   "dai": "帰雁"
  },
  {
   "seq": "20",
   "text": "つく〳〵とひとりみ山の春の雨にこひしく匂ふ花の夕かせ",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "十",
   "side": "",
   "dai": "帰雁"
  },
  {
   "seq": "21",
   "text": "わたの原は十嶋かけて咲花とみへりは雲か浪かありぬる",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "十一",
   "side": "",
   "dai": ""
  },
  {
   "seq": "22",
   "text": "たひはり立空みれは風の上にありかためぬ塵の身やこれは",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "十一",
   "side": "右",
   "dai": "雲雀"
  },
  {
   "seq": "23",
   "text": "咲かゝる藤の鳥居の立羽にもめくみをそたのむ行すゑの春",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "十二",
   "side": "左",
   "dai": "持蔵"
  },
  {
   "seq": "24",
   "text": "〽鶯のなく音物かき暮かたに春の日かすをうちかそへつゝ",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "十二",
   "side": "右",
   "dai": "暮春鶯"
  },
  {
   "seq": "25",
   "text": "心なくかへつとみるもさくらあさの名はむつましき賤の衣手",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "十三",
   "side": "左",
   "dai": "首夏更衣"
  },
  {
   "seq": "26",
   "text": "思るねに聞しはつ音をうつまてしたふ夢土のさよ郭公",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "十三",
   "side": "右",
   "dai": "郭公"
  },
  {
   "seq": "27",
   "text": "むら雨のはれゆく末の一声は月おちかゝるやまほとゝきす",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "十四",
   "side": "左",
   "dai": "郭公出"
  },
  {
   "seq": "28",
   "text": "道しあらはよもきか島のあやめをもけふこそからめ万世の宿",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "十四",
   "side": "",
   "dai": "郭公出"
  },
  {
   "seq": "29",
   "text": "〽さらてたに暮りたき日を夏引のいとしも長き来り雨空",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "十五",
   "side": "左",
   "dai": "勝五月西"
  },
  {
   "seq": "30",
   "text": "春秋のなかめ忘て松かけや夏の浜辺に住よしの月",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "十五",
   "side": "右",
   "dai": "夏月"
  },
  {
   "seq": "31",
   "text": "夕かほの花の軒はのうす煙かすみにわれし月のかけ哉",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "十六",
   "side": "左",
   "dai": "持夕顔"
  },
  {
   "seq": "32",
   "text": "夏の日もうす雪しろし山颪のから吹かへすそはの椎柴",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "十六",
   "side": "右",
   "dai": "夏風"
  },
  {
   "seq": "33",
   "text": "〽秋風を西にまつらの山かけてゆふ日涼しきおきつしら波",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "十七",
   "side": "左",
   "dai": "松浦山"
  },
  {
   "seq": "34",
   "text": "うき身世の秋をしれとや夕露の草木にもあらぬ袖に置らん",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "十七",
   "side": "右",
   "dai": "初秋"
  },
  {
   "seq": "35",
   "text": "我袖にあかつきふかき草の戸の明ぬに露や秋をつくらむ",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "十八",
   "side": "左",
   "dai": "持初秋暁露"
  },
  {
   "seq": "36",
   "text": "風もまた吹あへぬ秋の夕よりむくらに深き霜のしら露",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "十八",
   "side": "右",
   "dai": "早秋露"
  },
  {
   "seq": "37",
   "text": "ほし合の数にしとらは天河真砂もつきし久かたのそう",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "十九",
   "side": "左",
   "dai": "七夕"
  },
  {
   "seq": "38",
   "text": "〽さひしきを入あひのかねのうちそへて尾上の松に秋風そ吹",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "十九",
   "side": "右",
   "dai": "煩哥の中に"
  },
  {
   "seq": "39",
   "text": "宮城のゝ秋のけしきそしられけりをく露ふかれ庭の真萩に",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "廿",
   "side": "",
   "dai": ""
  },
  {
   "seq": "40",
   "text": "此深くうつろふ露に鳴野への鹿の上尾も萩は本すり",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "廿",
   "side": "右",
   "dai": "鹿交萩"
  },
  {
   "seq": "41",
   "text": "むとし野や音を鳴むしの数々に秋の思ひのはてもしられす",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "廿一",
   "side": "左",
   "dai": "野外虫"
  },
  {
   "seq": "42",
   "text": "一稀にたに露のふる道はらひきて誰かはとはむよもきふの宿は",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "廿一",
   "side": "右",
   "dai": "古郷露"
  },
  {
   "seq": "43",
   "text": "ね覚つゝみれはあらしの行末にかりかねさひし嶺の横雲",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "廿二",
   "side": "左",
   "dai": "初雁"
  },
  {
   "seq": "44",
   "text": "目にきて我うら黄こそ咲にけれ花を見すてし鳫のつらさも",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "廿二",
   "side": "右",
   "dai": "同"
  },
  {
   "seq": "45",
   "text": "もらさすも秋の千くさの末の露もとめて月のかけそやこれる",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "廿三",
   "side": "左",
   "dai": "月前露"
  },
  {
   "seq": "46",
   "text": "ね覚する枕にとをきしかの音に心をさそふ庭の松かせ",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "廿三",
   "side": "右",
   "dai": "外鹿"
  },
  {
   "seq": "47",
   "text": "遊ふされは萩のはそうく秋かせに露よりもろき我涙かな",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "廿四",
   "side": "左",
   "dai": "秋夕"
  },
  {
   "seq": "48",
   "text": "月さゆる山の秋かせ松ふけは雪にしくれのふるかとそきく",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "廿四",
   "side": "右",
   "dai": "勝月前風"
  },
  {
   "seq": "49",
   "text": "早くらくのはつせの山にすむ月に花も紅葉も誰かしのはん",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "廿五",
   "side": "左",
   "dai": "名所内"
  },
  {
   "seq": "50",
   "text": "しら雲のよそにもみへぬ秋風に月のみかゝかつらきの山",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "廿五",
   "side": "右",
   "dai": "同"
  },
  {
   "seq": "51",
   "text": "くまもなくなかめし人の心まてこよひ千里の月にみへつゝ",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "廿六",
   "side": "左",
   "dai": "翫月"
  },
  {
   "seq": "52",
   "text": "〽なかめつゝ思ひつきせぬ秋の夜にひとりはれ行月のかけかな",
   "kana": "",
   "speaker": "",
   "page": 17,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "廿六",
   "side": "右",
   "dai": "勝月"
  },
  {
   "seq": "53",
   "text": "詠るにこゝろのくまそなかりけり其身忘し秋のよの月",
   "kana": "",
   "speaker": "",
   "page": 17,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "廿七",
   "side": "",
   "dai": ""
  },
  {
   "seq": "54",
   "text": "身のうへにわきて思ひはなけれともなへて浮世の秋の夕くれ",
   "kana": "",
   "speaker": "",
   "page": 17,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "廿七",
   "side": "右",
   "dai": "秋夕"
  },
  {
   "seq": "55",
   "text": "あらし吹とを里をの先月かけも有明さむみ衣かつこゑ",
   "kana": "",
   "speaker": "",
   "page": 17,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "廿八",
   "side": "左",
   "dai": "遠擣衣"
  },
  {
   "seq": "56",
   "text": "秋これは夢ちはるかに成そ行月にねぬ夜のかすや積れる",
   "kana": "",
   "speaker": "",
   "page": 17,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "廿八",
   "side": "右",
   "dai": "秋度の中に"
  },
  {
   "seq": "57",
   "text": "有明の月のかけふく山風に千里まてしく秋のしら雪",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "廿九",
   "side": "左",
   "dai": "月の歌の中に"
  },
  {
   "seq": "58",
   "text": "なれみても言のは草の露はかりいひしるへくもあらぬ自哉",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "廿九",
   "side": "右",
   "dai": "秋情"
  },
  {
   "seq": "59",
   "text": "身の上を思ふに秋のなかきよもしらてふけぬる鐘の声哉",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "卅",
   "side": "",
   "dai": ""
  },
  {
   "seq": "60",
   "text": "残れ猶よもの木の葉は散ぬとも秋のかたみの袖の夕露",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "卅",
   "side": "左",
   "dai": "鷹秋露"
  },
  {
   "seq": "61",
   "text": "この頃は人もるみはれみ世中に空も隙なくふる時雨かな",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "卅",
   "side": "右",
   "dai": "伝馬"
  },
  {
   "seq": "62",
   "text": "山姫のおちは衣を吹かへしすそ野に残る木からしのかせ",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "卅二",
   "side": "左",
   "dai": "持落葉"
  },
  {
   "seq": "63",
   "text": "冬の夜に出き出てみれは草も木元霜かれわたる月のかけかあ",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "卅二",
   "side": "右",
   "dai": "冬月"
  },
  {
   "seq": "64",
   "text": "山風に光さし入柴の戸を明たにみる水のよのつき",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "卅三",
   "side": "左",
   "dai": "寒夜月"
  },
  {
   "seq": "65",
   "text": "承らす鳴千木のかたそき雪寒て氷に落る住の江の月",
   "kana": "",
   "speaker": "",
   "page": 20,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "卅三",
   "side": "右",
   "dai": "勝住吉浦"
  },
  {
   "seq": "66",
   "text": "さゝあかす伏見の里の朝戸出にけさ雪深しをはつせの山",
   "kana": "",
   "speaker": "",
   "page": 20,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "卅四",
   "side": "左",
   "dai": "持朝雪"
  },
  {
   "seq": "67",
   "text": "なかめきてこひしさ積る山のはの夕の雲に雪はふりつか",
   "kana": "",
   "speaker": "",
   "page": 20,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "卅四",
   "side": "右",
   "dai": "暮山雪"
  },
  {
   "seq": "68",
   "text": "あらし吹林にさは〳〵鳥の音も雪にしつまかゆふくれの空",
   "kana": "",
   "speaker": "",
   "page": 20,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "卅五",
   "side": "左",
   "dai": "雪の歌の中に"
  },
  {
   "seq": "69",
   "text": "岩ほしく滝のしら浪音絶て氷のうへにおつる山かせ",
   "kana": "",
   "speaker": "",
   "page": 20,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "卅五",
   "side": "右",
   "dai": "氷"
  },
  {
   "seq": "70",
   "text": "ほともなく冬の日かつる河浪に夜寒やおもふ鳴千とり哉",
   "kana": "",
   "speaker": "",
   "page": 21,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "卅五",
   "side": "左",
   "dai": "河子鳥"
  },
  {
   "seq": "71",
   "text": "うつり行人の心の花のけふをなきてはめようくひすのこゑ",
   "kana": "",
   "speaker": "",
   "page": 21,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "卅五",
   "side": "右",
   "dai": "春恋"
  },
  {
   "seq": "72",
   "text": "きえしたゝいくたの河のとり〳〵にあはてしつめる世かたりはうし",
   "kana": "",
   "speaker": "",
   "page": 21,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "卅七",
   "side": "左",
   "dai": "持不逢恋"
  },
  {
   "seq": "73",
   "text": "面か斗からに立そひてます鏡なみたなからもいくたひかみし",
   "kana": "",
   "speaker": "",
   "page": 22,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "卅七",
   "side": "右",
   "dai": "見増恋"
  },
  {
   "seq": "74",
   "text": "槙の戸に侍出る月もいたつらになみたこととふ在明のそら",
   "kana": "",
   "speaker": "",
   "page": 22,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "廿八",
   "side": "左",
   "dai": "恋の哥の中に"
  },
  {
   "seq": "75",
   "text": "うらみわひなかむともいさしら雲のしらしなよそに思ひきえぬる",
   "kana": "",
   "speaker": "",
   "page": 22,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "廿八",
   "side": "右",
   "dai": "同"
  },
  {
   "seq": "76",
   "text": "一稀にあふからみをしるや我なみしかたらぬさきに先こほれつゝ",
   "kana": "",
   "speaker": "",
   "page": 22,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "卅九",
   "side": "左",
   "dai": "勝問恋"
  },
  {
   "seq": "77",
   "text": "思ふをそ思ふとこそはおもひしにおもはぬ人をなと思ふらん",
   "kana": "",
   "speaker": "",
   "page": 23,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "卅九",
   "side": "右",
   "dai": "片恋"
  },
  {
   "seq": "78",
   "text": "胡露もまた消やらぬき悪〳〵のなこりの袖にそふなみたかな",
   "kana": "",
   "speaker": "",
   "page": 23,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "四十",
   "side": "左",
   "dai": "持後朝恋"
  },
  {
   "seq": "79",
   "text": "楽つかさの道のしは草露はあれとけこの涙やなをまさるらん",
   "kana": "",
   "speaker": "",
   "page": 23,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "四十",
   "side": "右",
   "dai": "別応"
  },
  {
   "seq": "80",
   "text": "思ひねにみえて夢ちのゆしゑをも枕やしるといふもはかなし",
   "kana": "",
   "speaker": "",
   "page": 23,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "四十一",
   "side": "右",
   "dai": "羽寄枕恋"
  },
  {
   "seq": "81",
   "text": "人めもる心のうちは小車のわかみのほかにやるかたもふし",
   "kana": "",
   "speaker": "",
   "page": 24,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "四十一",
   "side": "右",
   "dai": "寄車恋"
  },
  {
   "seq": "82",
   "text": "をのつからなひくすかたにふしわひてけになき竹のよをふかしつる",
   "kana": "",
   "speaker": "",
   "page": 24,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "四十二",
   "side": "左",
   "dai": "持恋竹"
  },
  {
   "seq": "83",
   "text": "契つゝ待こしくれの久しきも絶てとしふる身こそつらけれ",
   "kana": "",
   "speaker": "",
   "page": 24,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "四十二",
   "side": "右",
   "dai": "総久恋"
  },
  {
   "seq": "84",
   "text": "いさといふ人もなのみやみちのくのあねはの松に殊にことのは",
   "kana": "",
   "speaker": "",
   "page": 24,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "四十三",
   "side": "左",
   "dai": "殊名所松"
  },
  {
   "seq": "85",
   "text": "〽山里にとひくろへも松風を聞すてかたき夕ならすや",
   "kana": "",
   "speaker": "",
   "page": 24,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "四十三",
   "side": "右",
   "dai": "薄暮松"
  },
  {
   "seq": "86",
   "text": "わかのうらやをよはぬ道にあしたつの御はさ短音をのみそ鳴",
   "kana": "",
   "speaker": "",
   "page": 25,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "四十四",
   "side": "左",
   "dai": "村浦鶴"
  },
  {
   "seq": "87",
   "text": "世のうさをへたつるまてはしらねとも柴恒かこふ山の奥かな",
   "kana": "",
   "speaker": "",
   "page": 25,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "四十四",
   "side": "右",
   "dai": "山家"
  },
  {
   "seq": "88",
   "text": "〽古郷は思ひ諭たる宋の戸にみし世かへらぬ月もうらめし",
   "kana": "",
   "speaker": "",
   "page": 25,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "四十五",
   "side": "左",
   "dai": "特山家月"
  },
  {
   "seq": "89",
   "text": "松の戸にまてととはん古郷をめくりやきぬる山のはの月",
   "kana": "",
   "speaker": "",
   "page": 25,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "四十五",
   "side": "右",
   "dai": "月"
  },
  {
   "seq": "90",
   "text": "すなほならすかたをみれは朝夕にわか友ならぬ意のくれ竹",
   "kana": "",
   "speaker": "",
   "page": 26,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "四十六",
   "side": "左",
   "dai": "竹翠"
  },
  {
   "seq": "91",
   "text": "さひしきも誰かはとはん暮わたる槙の外山の雲の下庵",
   "kana": "",
   "speaker": "",
   "page": 26,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "四十六",
   "side": "右",
   "dai": "勝山家雲"
  },
  {
   "seq": "92",
   "text": "都思ふ菜のまくらのよすかまて旅ね物うき露の秋かせ",
   "kana": "",
   "speaker": "",
   "page": 26,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "四十七",
   "side": "左",
   "dai": "猿"
  },
  {
   "seq": "93",
   "text": "〽山深くいこひくるのみおほけれと世をすてはつる人そ稀なる",
   "kana": "",
   "speaker": "",
   "page": 26,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "四十七",
   "side": "右",
   "dai": "訪山家人稀"
  },
  {
   "seq": "94",
   "text": "大よとのかへる浪にも思ひ出てみやこの月にまつ風のこゑ",
   "kana": "",
   "speaker": "",
   "page": 27,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "四十八",
   "side": "左",
   "dai": "後泊月"
  },
  {
   "seq": "95",
   "text": "〽我なからなそも心のとまらうむすみははてしと思ふうき世に",
   "kana": "",
   "speaker": "",
   "page": 27,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "四十八",
   "side": "右",
   "dai": "述懐"
  },
  {
   "seq": "96",
   "text": "〽八雲たつ道はしらねとあさか山あさきよりこそおくも尋め",
   "kana": "",
   "speaker": "",
   "page": 27,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "四十八",
   "side": "左",
   "dai": "諸方寄道述懐"
  },
  {
   "seq": "97",
   "text": "目にみたひむかしの人の言葉を身にかへりみる心ともかな",
   "kana": "",
   "speaker": "",
   "page": 27,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "四十八",
   "side": "右",
   "dai": "懐香"
  },
  {
   "seq": "98",
   "text": "〽この国にむまれくる身もみかさ山世の契やかけし神かき",
   "kana": "",
   "speaker": "",
   "page": 28,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "五十",
   "side": "左",
   "dai": "勝神祇"
  },
  {
   "seq": "99",
   "text": "庭の松軒端の竹もかつしかゑて子も勢万代宿に契らん",
   "kana": "",
   "speaker": "",
   "page": 28,
   "pid": "nao-729570",
   "form": "短歌",
   "genre": "",
   "ban": "五十",
   "side": "右",
   "dai": "祝言"
  }
 ],
